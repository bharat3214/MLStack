# ======================
# MLStack Environment Variables
# ======================

# Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mlstack_db

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Redis (Celery)
REDIS_URL=redis://localhost:6379/0

# AI Provider Keys
GEMINI_API_KEY=
GROQ_API_KEY=

# SMTP / Mailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mlstack.hq@gmail.com
SMTP_PASS=xelyitcftbuksrxt
SMTP_FROM=mlstack.hq@gmail.com
MAILER_URL=http://mailer:4000

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
