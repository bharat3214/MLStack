# Backend Dockerfile (Flexible CPU/GPU)
ARG BASE_IMAGE=python:3.10-slim
FROM ${BASE_IMAGE}

# Prevent interactive prompts during install
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install system dependencies
# Works for both python:slim (Debian) and nvidia/cuda (Ubuntu)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    docker.io \
    libgl1 \
    libglib2.0-0 \
    curl \
    && if ! command -v python3 > /dev/null; then \
       apt-get install -y python3.10 python3-pip && \
       ln -sf /usr/bin/python3.10 /usr/bin/python && \
       ln -sf /usr/bin/pip3 /usr/bin/pip; \
    else \
       ln -sf /usr/bin/python3 /usr/bin/python; \
    fi \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for caching
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --timeout=600 --retries=3 -r requirements.txt

# Create a non-root user
RUN useradd -m -u 1000 appuser

# Copy application code
COPY backend/ .

# Copy helper scripts outside /app to avoid bind-mount overrides
COPY backend/scripts /usr/local/bin
RUN chmod +x /usr/local/bin/entrypoint.sh

# Change ownership to the non-root user
RUN chown -R appuser:appuser /app

# Switch to the non-root user
# USER appuser

# Expose port
EXPOSE 5000

# Use entrypoint to initialize DB then start the app
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["python", "run.py"]
